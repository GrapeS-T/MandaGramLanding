mandagram.com {
    root * /srv/mandagram/current
    encode zstd gzip

    @deployment path /deployment.txt
    header @deployment Cache-Control "no-store"

    @assets path /_a/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    file_server
    handle_errors {
        @notFound expression {http.error.status_code} == 404
        rewrite @notFound /404.html
        file_server
    }
}
