---
interface Props {
  size?: 'sm' | 'lg';
  idPrefix?: string;
  placeholder?: string;
}

const { size = 'sm', idPrefix = 'kbs', placeholder = 'Поиск по статьям' } = Astro.props;
---
<form class={`kbs kbs--${size}`} action="/kb/" method="get" role="search" data-kbs="">
  <label class="sfield">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="ic" aria-hidden="true" focusable="false"><path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247L16.0247 15.8748Z"></path></svg>
    <span class="sr-only">Поиск по базе знаний</span>
    <input 
      type="search" 
      name="q" 
      placeholder={placeholder} 
      autocomplete="off" 
      enterkeyhint="search" 
      spellcheck="false" 
      role="combobox" 
      aria-expanded="false" 
      aria-autocomplete="list" 
      aria-controls={`${idPrefix}-res`} 
      data-kbs-input="" 
    />
    <kbd class="kbs-key" aria-hidden="true">/</kbd>
    <button class="kbs-clear" type="button" aria-label="Очистить" hidden="" data-kbs-clear="">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="ic" aria-hidden="true" focusable="false"><path d="M11.9997 10.5865L16.9495 5.63672L18.3637 7.05093L13.4139 12.0007L18.3637 16.9504L16.9495 18.3646L11.9997 13.4149L7.04996 18.3646L5.63574 16.9504L10.5855 12.0007L5.63574 7.05093L7.04996 5.63672L11.9997 10.5865Z"></path></svg>
    </button>
  </label>
  <div class="kbs-res" id={`${idPrefix}-res`} role="listbox" aria-label="Результаты поиска" hidden="" data-kbs-res=""></div>
  <p class="sr-only" aria-live="polite" data-kbs-status=""></p>
</form>

<script>
  type SearchRow = [string, string, string, string];
  let index: Promise<SearchRow[]> | undefined;
  const normalize = (text: string) => text.toLocaleLowerCase('ru').replaceAll('ё', 'е');

  document.querySelectorAll<HTMLFormElement>('[data-kbs]').forEach(form => {
    const input = form.querySelector<HTMLInputElement>('[data-kbs-input]')!;
    const results = form.querySelector<HTMLDivElement>('[data-kbs-res]')!;
    const clear = form.querySelector<HTMLButtonElement>('[data-kbs-clear]')!;
    const status = form.querySelector<HTMLElement>('[data-kbs-status]')!;
    let generation = 0;
    let selected = -1;

    const close = () => {
      generation++;
      results.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      selected = -1;
    };

    const search = async () => {
      const current = ++generation;
      const words = normalize(input.value.trim()).split(/\s+/).filter(Boolean);
      clear.hidden = !words.length;
      results.replaceChildren();
      selected = -1;
      input.removeAttribute('aria-activedescendant');
      if (!words.length) {
        close();
        status.textContent = '';
        return;
      }
      try {
        index ??= fetch('/kb/search.json').then(async response => {
          if (!response.ok) throw new Error('Search index unavailable');
          return (await response.json()).a as SearchRow[];
        }).catch(error => { index = undefined; throw error; });
        const rows = await index;
        if (current !== generation) return;
        const matches = rows.map(row => {
          const [, title, category, text] = row;
          const heading = normalize(title);
          const haystack = normalize(`${title} ${category} ${text}`);
          const score = heading === words.join(' ') ? 3
            : words.every(word => heading.includes(word)) ? 2 : 1;
          return { row, score, matches: words.every(word => haystack.includes(word)) };
        }).filter(result => result.matches)
          .sort((a, b) => b.score - a.score)
          .slice(0, 8).map(result => result.row);
        matches.forEach(([slug, title, category], position) => {
          const link = document.createElement('a');
          link.className = 'kbs-hit';
          const [article, anchor] = slug.split('#');
          link.href = `/kb/${article}/${anchor ? `#${anchor}` : ''}`;
          link.id = `${results.id}-${position}`;
          link.setAttribute('role', 'option');
          link.setAttribute('aria-selected', 'false');
          const heading = document.createElement('strong');
          heading.className = 'h-t';
          heading.textContent = title;
          const detail = document.createElement('span');
          detail.className = 'h-s';
          detail.textContent = category;
          link.append(heading, detail);
          link.addEventListener('click', close);
          results.append(link);
        });
        status.textContent = matches.length ? `Найдено результатов: ${matches.length}` : 'Совпадений не найдено';
        if (!matches.length) results.textContent = 'Совпадений не найдено';
      } catch {
        if (current !== generation) return;
        results.textContent = 'Не удалось загрузить поиск. Выберите статью в каталоге ниже.';
        status.textContent = results.textContent;
      }
      results.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    input.addEventListener('input', search);
    input.addEventListener('focus', search);
    clear.addEventListener('click', () => { input.value = ''; input.focus(); void search(); });
    form.addEventListener('submit', event => { event.preventDefault(); void search(); });
    input.addEventListener('keydown', event => {
      if (event.key === 'Escape') { close(); return; }
      const links = [...results.querySelectorAll<HTMLAnchorElement>('a')];
      if (results.hidden || !links.length) return;
      if (event.key === 'Enter' && selected >= 0) {
        event.preventDefault();
        links[selected].click();
      } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        selected = selected < 0
          ? (event.key === 'ArrowDown' ? 0 : links.length - 1)
          : (selected + (event.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
        links.forEach((link, position) => link.setAttribute('aria-selected', String(position === selected)));
        input.setAttribute('aria-activedescendant', links[selected].id);
        links[selected].scrollIntoView({ block: 'nearest' });
      }
    });
    document.addEventListener('pointerdown', event => {
      if (!form.contains(event.target as Node)) close();
    });
    input.value = new URLSearchParams(location.search).get('q') ?? '';
    if (input.value) void search();
  });

  document.addEventListener('keydown', event => {
    if (event.key !== '/' || event.ctrlKey || event.altKey || event.metaKey) return;
    if ((event.target as HTMLElement).closest('input, textarea, [contenteditable="true"]')) return;
    const input = [...document.querySelectorAll<HTMLInputElement>('[data-kbs-input]')]
      .find(element => element.getClientRects().length > 0);
    if (input) { event.preventDefault(); input.focus(); }
  });
</script>
